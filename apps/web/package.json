{
  "name": "@portfolio/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser:paper": "npm run build && playwright test --config tests/paper-browser/playwright.config.ts",
    "test:browser": "playwright test lifecycle.e2e.ts",
    "test:browser:portfolio-list": "bash tests/browser/portfolio-list-visual.sh",
    "test:browser:persistence": "BROWSER_VERIFY_RECEIPT=1 playwright test lifecycle.e2e.ts",
    "test:browser:market": "playwright test market-operations.e2e.ts",
    "test:browser:market:persistence": "MARKET_OPS_VERIFY_RECEIPT=1 playwright test market-operations.e2e.ts",
    "test:browser:p1": "playwright test p1.e2e.ts",
    "test:browser:p1:persistence": "P1_VERIFY_RECEIPT=1 playwright test p1.e2e.ts",
    "test:browser:chat:llm": "CHAT_LLM_LIVE=1 playwright test chat.e2e.ts --grep 'real Chat LLM'",
    "test:browser:chat:llm:persistence": "CHAT_LLM_LIVE=1 CHAT_VERIFY_RECEIPT=1 playwright test chat.e2e.ts --grep 'real Chat LLM'",
    "test:browser:chat": "playwright test chat.e2e.ts",
    "test:browser:chat:persistence": "CHAT_VERIFY_RECEIPT=1 playwright test chat.e2e.ts",
    "test:browser:chat:outage": "CHAT_PROVIDER_OUTAGE=1 playwright test chat.e2e.ts",
    "test:browser:knowledge": "playwright test knowledge.e2e.ts",
    "test:browser:knowledge:persistence": "KNOWLEDGE_VERIFY_RECEIPT=1 playwright test knowledge.e2e.ts",
    "test:browser:phase1-full": "playwright test phase1-full.e2e.ts",
    "test:browser:phase1-full:stale": "PHASE1_FULL_EXPECT=vff-stale playwright test phase1-full.e2e.ts",
    "test:browser:phase1-full:persistence": "PHASE1_FULL_VERIFY_RECEIPT=1 playwright test phase1-full.e2e.ts",
    "test:browser:user-selection": "playwright test user-selection.e2e.ts",
    "test:browser:user-selection:persistence": "USER_SELECTION_VERIFY_RECEIPT=1 playwright test user-selection.e2e.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "jose": "6.2.12",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "6.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
