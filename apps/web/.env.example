# Local development only. Generate secrets with infra/local bootstrap or openssl.
APP_ORIGIN=http://localhost:3000
OIDC_ISSUER=http://localhost:8080/realms/portfolio
# Docker only: rewrite server network requests without changing public issuer.
# OIDC_INTERNAL_ORIGIN=http://keycloak:8080
OIDC_CLIENT_ID=portfolio-web
OIDC_CLIENT_SECRET=replace-with-keycloak-client-secret
OIDC_AUDIENCE=portfolio-api
OIDC_SCOPE=openid profile email portfolio:read portfolio:write
REDIS_URL=redis://localhost:6379/0
# openssl rand -base64 32
SESSION_ENCRYPTION_KEY=replace-with-base64-32-byte-random-key
SESSION_TTL_SECONDS=28800
PORTFOLIO_API_URL=http://localhost:8001
# Explicit local HTTP exception; omit this and use HTTPS outside local demo.
ALLOW_INSECURE_HTTP=true

# Optional local traces; auth callbacks and framework automatic spans are excluded.
OTEL_TRACES_ENABLED=false
OTEL_SERVICE_NAME=web-bff
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
TRACE_VIEWER_URL=http://localhost:16686
