# CONFIGURATION EXAMPLE ONLY. These placeholders do not authorize a deployment.
# Store real env files outside Git with mode 0600 and use a secret manager.
WEB_IMAGE=registry.example.invalid/portfolio/web:0.1.0
PORTFOLIO_IMAGE=registry.example.invalid/portfolio/portfolio:0.1.0
QUANT_IMAGE=registry.example.invalid/portfolio/quant:0.1.0
MARKET_IMAGE=registry.example.invalid/portfolio/market:0.1.0
APP_ORIGIN=https://app.example.invalid
OIDC_ISSUER=https://identity.example.invalid/realms/portfolio
OIDC_JWKS_URL=https://identity.example.invalid/realms/portfolio/protocol/openid-connect/certs
OIDC_TOKEN_URL=https://identity.example.invalid/realms/portfolio/protocol/openid-connect/token
OIDC_INTERNAL_ORIGIN=https://identity.example.invalid
OIDC_CLIENT_ID=portfolio-web
OIDC_CLIENT_SECRET=CHANGE_ME
QUANT_CLIENT_SECRET=CHANGE_ME
# Placeholder zero bytes are rejected unless --allow-example is explicitly used.
SESSION_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
REDIS_URL=rediss://portfolio_web:CHANGE_ME@redis.example.invalid:6379/0
PORTFOLIO_DATABASE_URL=postgresql+psycopg://portfolio_runtime:CHANGE_ME@postgres.example.invalid:5432/portfolio_db?sslmode=verify-full
PORTFOLIO_MIGRATION_DATABASE_URL=postgresql+psycopg://portfolio_migrator:CHANGE_ME@postgres.example.invalid:5432/portfolio_db?sslmode=verify-full
QUANT_DATABASE_URL=postgresql+psycopg://quant_runtime:CHANGE_ME@postgres.example.invalid:5432/quant_db?sslmode=verify-full
QUANT_MIGRATION_DATABASE_URL=postgresql+psycopg://quant_migrator:CHANGE_ME@postgres.example.invalid:5432/quant_db?sslmode=verify-full
MARKET_DATABASE_URL=postgresql+psycopg://market_runtime:CHANGE_ME@postgres.example.invalid:5432/market_db?sslmode=verify-full
MARKET_MIGRATION_DATABASE_URL=postgresql+psycopg://market_migrator:CHANGE_ME@postgres.example.invalid:5432/market_db?sslmode=verify-full
PORTFOLIO_PUBLISHER_BROKER_URL=amqps://portfolio_publisher:CHANGE_ME@broker.example.invalid:5671/portfolio
PORTFOLIO_CONSUMER_BROKER_URL=amqps://portfolio_consumer:CHANGE_ME@broker.example.invalid:5671/portfolio
QUANT_PUBLISHER_BROKER_URL=amqps://quant_publisher:CHANGE_ME@broker.example.invalid:5671/portfolio
QUANT_CONSUMER_BROKER_URL=amqps://quant_consumer:CHANGE_ME@broker.example.invalid:5671/portfolio
MARKET_PUBLISHER_BROKER_URL=amqps://market_publisher:CHANGE_ME@broker.example.invalid:5671/portfolio
MARKET_CONSUMER_BROKER_URL=amqps://market_consumer:CHANGE_ME@broker.example.invalid:5671/portfolio
BUNDLE_DIRECTORY=/srv/portfolio/bundles
DATASET_DIRECTORY=/srv/portfolio/datasets
# CA directory contains ca.pem with the trusted dependency CA chain.
TLS_CA_DIRECTORY=/srv/portfolio/ca
