  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ReviewRequest": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "APPROVED",
              "REJECTED"
            ],
            "title": "Decision"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision",
          "reason"
        ],
        "title": "ReviewRequest"
      },
      "TrainingRequest": {
        "properties": {
          "snapshot_id": {
            "type": "string",
            "format": "uuid",
            "title": "Snapshot Id"
          },
          "snapshot_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Snapshot Hash"
          },
          "training_cutoff": {
            "type": "string",
            "format": "date",
            "title": "Training Cutoff"
          },
          "max_age_days": {
            "type": "integer",
            "maximum": 30.0,
            "minimum": 1.0,
            "title": "Max Age Days",
            "default": 7
          },
          "lookback": {
            "type": "integer",
            "maximum": 2520.0,
            "minimum": 20.0,
            "title": "Lookback",
            "default": 252
          },
          "min_returns": {
            "type": "integer",
            "maximum": 2520.0,
            "minimum": 20.0,
            "title": "Min Returns",
            "default": 60
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "snapshot_id",
          "snapshot_hash",
          "training_cutoff"
        ],
        "title": "TrainingRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
