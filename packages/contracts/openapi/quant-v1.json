    "/internal/v1/inputs/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_internal_v1_inputs_ready_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "universe_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Universe Id"
            }
          },
          {
            "name": "strategy",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "EW",
                "MVO",
                "BL_ML"
              ],
              "type": "string",
              "title": "Strategy"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
