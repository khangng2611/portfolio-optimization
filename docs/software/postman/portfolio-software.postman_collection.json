            "url": "{{portfolio_url}}/api/v1/portfolios/{{portfolio_id}}/recommendations",
            "description": "Giữ key cho retry. Xóa recommendation_key để tạo một yêu cầu mới.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"strategy\": \"MVO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get(\"recommendation_key\")) pm.environment.set(\"recommendation_key\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 202\", () => pm.response.to.have.status(202));",
                  "if (pm.response.code === 202) { const x = pm.response.json(); pm.environment.set(\"job_id\", x.job_id); pm.environment.set(\"status_url\", x.status_url); pm.environment.unset(\"recommendation_id\"); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry same recommendation key and body",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
