    {
      "name": "04 Market",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{market_token}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Ingest registered DEMO_STOCK CSV",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{ingestion_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{market_url}}/api/v1/market/ingestions",
            "description": "Server registry CSV; không truyền path/URL. Ngày mặc định UTC hôm nay, chỉnh environment nếu dùng dataset khác.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dataset_id\": \"DEMO_STOCK\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const today = new Date().toISOString().slice(0,10);",
                  "for (const name of [\"market_start_date\", \"market_end_date\", \"market_as_of_date\"]) if (!pm.environment.get(name)) pm.environment.set(name, today);",
                  "if (!pm.environment.get(\"ingestion_key\")) pm.environment.set(\"ingestion_key\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 202\", () => pm.response.to.have.status(202));",
                  "if (pm.response.code === 202) { const x=pm.response.json(); pm.environment.set(\"market_job_id\", x.job_id); pm.environment.set(\"market_status_url\", x.status_url); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry same ingestion key and body",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{ingestion_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{market_url}}/api/v1/market/ingestions",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dataset_id\": \"DEMO_STOCK\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 202\", () => pm.response.to.have.status(202));",
                  "if (pm.response.code === 202) pm.test(\"Same ingestion job\", () => pm.expect(pm.response.json().job_id).to.eql(pm.environment.get(\"market_job_id\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Conflicting ingestion key is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{ingestion_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{market_url}}/api/v1/market/ingestions",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"observations\": [\n    {\n      \"asset_id\": \"{{market_asset_id}}\",\n      \"kind\": \"stock\",\n      \"observation_date\": \"{{market_end_date}}\",\n      \"price\": \"25000\",\n      \"source_unit\": \"VND/share\",\n      \"provider\": \"synthetic-local\",\n      \"price_type\": \"close\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const today = new Date().toISOString().slice(0,10);",
                  "for (const name of [\"market_start_date\", \"market_end_date\", \"market_as_of_date\"]) if (!pm.environment.get(name)) pm.environment.set(name, today);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Poll ingestion job",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{market_url}}{{market_status_url}}",
            "description": "Gửi lại đến SUCCEEDED rồi đọc prices/tạo snapshot. FAILED có error; không suy ra job thành công chỉ từ HTTP 200."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const x=pm.response.json(); pm.test(\"Known ingestion state\", () => pm.expect([\"QUEUED\", \"SUCCEEDED\", \"FAILED\"]).to.include(x.status)); if (x.status === \"FAILED\") pm.test(\"Ingestion succeeds\", () => pm.expect(x.status).to.eql(\"SUCCEEDED\")); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Bob cannot read operator ingestion job",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{market_url}}/api/v1/jobs/market/{{market_job_id}}",
            "description": "",
