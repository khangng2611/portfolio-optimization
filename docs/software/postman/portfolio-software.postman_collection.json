          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{normalized_ingestion_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{market_url}}/api/v1/market/ingestions",
            "description": "Một request dùng dataset_id HOẶC observations. Giá/unit phải phù hợp asset kind. Xóa normalized_ingestion_key trước khi gửi body khác; poll job rồi kiểm tra snapshot cũ vẫn cùng hash.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"observations\": [\n    {\n      \"asset_id\": \"{{market_asset_id}}\",\n      \"kind\": \"stock\",\n      \"observation_date\": \"{{market_end_date}}\",\n      \"price\": \"25000\",\n      \"source_unit\": \"VND/share\",\n      \"provider\": \"synthetic-local\",\n      \"price_type\": \"close\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const today = new Date().toISOString().slice(0,10);",
                  "for (const name of [\"market_start_date\", \"market_end_date\", \"market_as_of_date\"]) if (!pm.environment.get(name)) pm.environment.set(name, today);",
                  "if (!pm.environment.get(\"normalized_ingestion_key\")) pm.environment.set(\"normalized_ingestion_key\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
