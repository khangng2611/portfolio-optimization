{
  "additionalProperties": false,
  "properties": {
    "candidate_asset_ids": {
      "items": {
        "pattern": "^[A-Z0-9_-]{1,64}$",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Candidate Asset Ids",
      "type": "array"
    },
    "revision_id": {
      "format": "uuid",
      "title": "Revision Id",
      "type": "string"
    },
    "portfolio_id": {
      "format": "uuid",
      "title": "Portfolio Id",
      "type": "string"
    },
    "portfolio_version": {
      "minimum": 1,
      "title": "Portfolio Version",
      "type": "integer"
    },
    "candidate_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Candidate Hash",
      "type": "string"
    },
    "selection_policy_id": {
      "const": "user-k5-v1",
      "default": "user-k5-v1",
      "title": "Selection Policy Id",
      "type": "string"
    },
    "risk_policy_id": {
      "const": "custom-mixed-risk-v1",
      "default": "custom-mixed-risk-v1",
      "title": "Risk Policy Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "candidate_asset_ids",
    "revision_id",
    "portfolio_id",
    "portfolio_version",
    "candidate_hash",
    "created_at"
  ],
  "title": "SelectionRevision",
  "type": "object"
}
