  "components": {
    "schemas": {
      "Confirmation": {
        "properties": {
          "message_id": {
            "type": "string",
            "format": "uuid",
            "title": "Message Id"
          },
          "facts_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Facts Hash"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message_id",
          "facts_hash"
        ],
        "title": "Confirmation"
      },
      "ConversationPreferences": {
        "properties": {
          "llm_consent": {
            "type": "boolean",
            "title": "Llm Consent"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "llm_consent"
        ],
        "title": "ConversationPreferences"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NewConversation": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Title",
            "default": "Hội thoại mới"
          },
          "portfolio_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Portfolio Id"
          },
          "llm_consent": {
            "type": "boolean",
            "title": "Llm Consent",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "NewConversation"
      },
      "NewMessage": {
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Content"
          },
          "client_message_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Client Message Id"
          },
          "portfolio_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Portfolio Id"
          },
          "intent": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "allocation",
                  "profile",
                  "portfolio",
                  "market",
                  "explain",
                  "help"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Intent"
          },
          "strategy": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "EW",
                  "MVO",
                  "BL_ML"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Strategy"
          },
          "recommendation_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recommendation Id"
          },
          "confirmation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Confirmation"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "content",
          "client_message_id"
        ],
        "title": "NewMessage"
      },
      "ResumeRequest": {
        "properties": {
          "confirmed": {
            "type": "boolean",
            "const": true,
            "title": "Confirmed"
          },
          "authorization_id": {
            "type": "string",
            "format": "uuid",
            "title": "Authorization Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirmed",
          "authorization_id"
        ],
        "title": "ResumeRequest"
      },
      "StrictModel": {
        "properties": {},
        "additionalProperties": false,
        "type": "object",
        "title": "StrictModel"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
