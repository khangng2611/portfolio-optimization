  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NewPortfolio": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Name"
          },
          "capital_vnd": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1e+19,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Capital Vnd"
          },
          "universe_id": {
            "type": "string",
            "pattern": "^[A-Z0-9_-]{1,64}$",
            "title": "Universe Id",
            "default": "DEMO"
          },
          "risk_aversion": {
            "type": "number",
            "maximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Risk Aversion",
            "default": 1.5
          },
          "max_position_weight": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Max Position Weight",
            "default": 0.5
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "capital_vnd"
        ],
        "title": "NewPortfolio"
      },
      "NewRecommendation": {
        "properties": {
          "strategy": {
            "type": "string",
            "enum": [
              "EW",
              "MVO",
              "BL_ML"
            ],
            "title": "Strategy",
            "default": "MVO"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "NewRecommendation"
      },
      "PortfolioUpdate": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120,
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "capital_vnd": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1e+19,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Capital Vnd"
          },
          "risk_aversion": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Risk Aversion"
          },
          "max_position_weight": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Position Weight"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "PortfolioUpdate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
