{
  "$defs": {
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^[A-Z0-9_-]{1,64}$",
          "title": "Asset Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "stock",
            "fund",
            "gold"
          ],
          "title": "Kind",
          "type": "string"
        },
        "observation_date": {
          "format": "date",
          "title": "Observation Date",
          "type": "string"
        },
        "price": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1e+17,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Price"
        },
        "source_unit": {
          "title": "Source Unit",
          "type": "string"
        },
        "provider": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "price_type": {
          "default": "close",
          "enum": [
            "close",
            "nav",
            "bid",
            "ask",
            "midpoint"
          ],
          "title": "Price Type",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "kind",
        "observation_date",
        "price",
        "source_unit",
        "provider"
      ],
      "title": "Observation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dataset_id": {
      "anyOf": [
        {
          "pattern": "^[A-Z0-9_-]{1,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Id"
    },
    "observations": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "maxItems": 5000,
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observations"
    }
  },
  "title": "IngestionRequest",
  "type": "object"
}
