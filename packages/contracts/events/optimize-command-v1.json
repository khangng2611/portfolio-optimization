{
  "$defs": {
    "Constraints": {
      "additionalProperties": false,
      "properties": {
        "risk_aversion": {
          "default": 1.5,
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Risk Aversion",
          "type": "number"
        },
        "max_position_weight": {
          "default": 0.5,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Max Position Weight",
          "type": "number"
        },
        "defensive_asset_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Defensive Asset Ids",
          "type": "array"
        },
        "min_defensive_weight": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Min Defensive Weight",
          "type": "number"
        },
        "max_non_defensive_weight": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Max Non Defensive Weight",
          "type": "number"
        }
      },
      "title": "Constraints",
      "type": "object"
    },
    "DecisionContext": {
      "additionalProperties": false,
      "properties": {
        "policy_version_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Policy Version Id",
          "type": "string"
        },
        "risk_profile": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Risk Profile"
        },
        "requested_strategy": {
          "enum": [
            "EW",
            "MVO",
            "BL_ML",
            "HYBRID"
          ],
          "title": "Requested Strategy",
          "type": "string"
        },
        "fallback_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Reason"
        },
        "requested_constraints": {
          "anyOf": [
            {
              "$ref": "#/$defs/Constraints"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "policy_version_id",
        "requested_strategy"
      ],
      "title": "DecisionContext",
      "type": "object"
    },
    "HybridPolicy": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "phase1-hybrid-profile-v1",
          "title": "Version",
          "type": "string"
        },
        "mvo_share": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Mvo Share",
          "type": "number"
        }
      },
      "required": [
        "version",
        "mvo_share"
      ],
      "title": "HybridPolicy",
      "type": "object"
    },
    "ReadyInput": {
      "additionalProperties": false,
      "properties": {
        "bundle_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Bundle Id",
          "type": "string"
        },
        "bundle_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Bundle Hash",
          "type": "string"
        },
        "snapshot_id": {
          "title": "Snapshot Id",
          "type": "string"
        },
        "model_bundle_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Bundle Id"
        },
        "asset_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 2,
          "title": "Asset Ids",
          "type": "array"
        },
        "as_of_date": {
          "title": "As Of Date",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        },
        "demo": {
          "default": false,
          "title": "Demo",
          "type": "boolean"
        },
        "provenance": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance"
        }
      },
      "required": [
        "bundle_id",
        "bundle_hash",
        "snapshot_id",
        "asset_ids",
        "as_of_date",
        "valid_until"
      ],
      "title": "ReadyInput",
      "type": "object"
    },
    "RegimeInfo": {
      "additionalProperties": false,
      "properties": {
        "regime": {
          "enum": [
            "normal",
            "stress",
            "crisis"
          ],
          "title": "Regime",
          "type": "string"
        },
        "vol_ratio": {
          "minimum": 0,
          "title": "Vol Ratio",
          "type": "number"
        },
        "drawdown": {
          "title": "Drawdown",
          "type": "number"
        },
        "equity_momentum": {
          "title": "Equity Momentum",
          "type": "number"
        }
      },
      "required": [
        "regime",
        "vol_ratio",
        "drawdown",
        "equity_momentum"
      ],
      "title": "RegimeInfo",
      "type": "object"
    },
    "SelectionContext": {
      "additionalProperties": false,
      "properties": {
        "candidate_asset_ids": {
          "items": {
            "pattern": "^[A-Z0-9_-]{1,64}$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Candidate Asset Ids",
          "type": "array"
        },
        "revision_id": {
          "format": "uuid",
          "title": "Revision Id",
          "type": "string"
        },
        "candidate_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Candidate Hash",
          "type": "string"
        },
        "selection_policy_id": {
          "const": "user-k5-v1",
          "default": "user-k5-v1",
          "title": "Selection Policy Id",
          "type": "string"
        },
        "risk_policy_id": {
          "const": "custom-mixed-risk-v1",
          "default": "custom-mixed-risk-v1",
          "title": "Risk Policy Id",
          "type": "string"
        },
        "data_policy_id": {
          "default": "user-selection-data-v1",
          "enum": [
            "user-selection-data-v1",
            "user-selection-live-nav-v2"
          ],
          "title": "Data Policy Id",
          "type": "string"
        },
        "regime_policy_id": {
          "const": "candidate-regime-v1",
          "default": "candidate-regime-v1",
          "title": "Regime Policy Id",
          "type": "string"
        },
        "regime": {
          "$ref": "#/$defs/RegimeInfo"
        },
        "regime_input_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Regime Input Hash",
          "type": "string"
        },
        "decision_at": {
          "format": "date-time",
          "title": "Decision At",
          "type": "string"
        },
        "decision_session": {
          "format": "date",
          "title": "Decision Session",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "candidate_asset_ids",
        "revision_id",
        "candidate_hash",
        "regime",
        "regime_input_hash",
        "decision_at",
        "decision_session",
        "valid_until"
      ],
      "title": "SelectionContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "owner_user_id": {
      "format": "uuid",
      "title": "Owner User Id",
      "type": "string"
    },
    "portfolio_id": {
      "format": "uuid",
      "title": "Portfolio Id",
      "type": "string"
    },
    "portfolio_version": {
      "minimum": 1,
      "title": "Portfolio Version",
      "type": "integer"
    },
    "strategy": {
      "enum": [
        "EW",
        "MVO",
        "BL_ML",
        "HYBRID"
      ],
      "title": "Strategy",
      "type": "string"
    },
    "core_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Core Version",
      "type": "string"
    },
    "capital_vnd": {
      "title": "Capital Vnd",
      "type": "string"
    },
    "inputs": {
      "$ref": "#/$defs/ReadyInput"
    },
    "constraints": {
      "$ref": "#/$defs/Constraints"
    },
    "decision_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/DecisionContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "selection_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/SelectionContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "hybrid_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/HybridPolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "input_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Input Hash",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "owner_user_id",
    "portfolio_id",
    "portfolio_version",
    "strategy",
    "capital_vnd",
    "inputs",
    "constraints",
    "deadline",
    "input_hash"
  ],
  "title": "OptimizeCommand",
  "type": "object"
}
