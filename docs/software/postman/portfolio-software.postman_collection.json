        {
          "name": "Create immutable snapshot",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{market_url}}/api/v1/market/snapshots",
            "description": "Thiếu/stale dữ liệu trả 409. Chọn range/as-of theo observations đã ingest.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"asset_ids\": [\n    \"{{market_asset_id}}\"\n  ],\n  \"start_date\": \"{{market_start_date}}\",\n  \"end_date\": \"{{market_end_date}}\",\n  \"as_of_date\": \"{{market_as_of_date}}\",\n  \"max_age_days\": 7\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const today = new Date().toISOString().slice(0,10);",
                  "for (const name of [\"market_start_date\", \"market_end_date\", \"market_as_of_date\"]) if (!pm.environment.get(name)) pm.environment.set(name, today);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { const x=pm.response.json(); pm.environment.set(\"snapshot_id\", x.id); pm.environment.set(\"snapshot_hash\", x.content_hash); }"
                ]
              }
            }
          ]
        },
