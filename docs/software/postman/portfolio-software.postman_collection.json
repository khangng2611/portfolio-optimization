        {
          "name": "Poll recommendation job",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{portfolio_url}}{{status_url}}",
            "description": "Gửi lại thủ công đến SUCCEEDED. Không chạy request kết quả khi đang QUEUED. Runner không tự poll."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const x = pm.response.json(); pm.test(\"Known job state\", () => pm.expect([\"QUEUED\", \"SUCCEEDED\", \"FAILED\"]).to.include(x.status)); if (x.status === \"SUCCEEDED\") pm.environment.set(\"recommendation_id\", x.recommendation_id); if (x.status === \"FAILED\") pm.test(\"Job succeeds\", () => pm.expect(x.status).to.eql(\"SUCCEEDED\")); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Read persisted recommendation",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{portfolio_url}}/api/v1/recommendations/{{recommendation_id}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const x = pm.response.json(); const w = x.weights.map(Number); pm.test(\"Weights satisfy constraints\", () => { pm.expect(Math.abs(w.reduce((a,b) => a+b,0)-1)).to.be.below(1e-7); pm.expect(Math.max(...w)).to.be.at.most(0.5000001); }); pm.test(\"Provenance exists\", () => { pm.expect(x.strategy).to.eql(\"MVO\"); pm.expect(x.core_version).to.eql(\"0.1.0\"); pm.expect(x.bundle_hash).to.match(/^[a-f0-9]{64}$/); pm.expect(x.data_snapshot_id).to.be.a(\"string\").and.not.empty; }); }"
                ]
