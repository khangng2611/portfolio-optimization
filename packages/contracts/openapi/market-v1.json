  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestionRequest": {
        "properties": {
          "dataset_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z0-9_-]{1,64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dataset Id"
          },
          "observations": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Observation"
                },
                "type": "array",
                "maxItems": 5000,
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Observations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "IngestionRequest"
      },
      "Observation": {
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^[A-Z0-9_-]{1,64}$",
            "title": "Asset Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "stock",
              "fund",
              "gold"
            ],
            "title": "Kind"
          },
          "observation_date": {
            "type": "string",
            "format": "date",
            "title": "Observation Date"
          },
          "price": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1e+17,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Price"
          },
          "source_unit": {
            "type": "string",
            "title": "Source Unit"
          },
          "provider": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Provider"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "price_type": {
            "type": "string",
            "enum": [
              "close",
              "nav",
              "bid",
              "ask",
              "midpoint"
            ],
            "title": "Price Type",
            "default": "close"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "asset_id",
          "kind",
          "observation_date",
          "price",
          "source_unit",
          "provider"
        ],
        "title": "Observation"
      },
      "SnapshotRequest": {
        "properties": {
          "asset_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Asset Ids"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "title": "Start Date"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "title": "End Date"
          },
          "as_of_date": {
            "type": "string",
            "format": "date",
            "title": "As Of Date"
          },
          "max_age_days": {
            "type": "integer",
            "maximum": 365.0,
            "minimum": 0.0,
            "title": "Max Age Days",
            "default": 7
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "asset_ids",
          "start_date",
          "end_date",
          "as_of_date"
        ],
        "title": "SnapshotRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
