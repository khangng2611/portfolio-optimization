# Local Compose network. Generate credentials with infra/local/bootstrap.py.
APP_ORIGIN=http://localhost:3000
OIDC_ISSUER=http://auth-api:8000
AUTH_API_URL=http://auth-api:8000
AUTH_WEB_SECRET=replace-with-local-auth-web-secret
REDIS_URL=redis://:replace-with-local-redis-password@redis:6379/0
# openssl rand -base64 32
SESSION_ENCRYPTION_KEY=replace-with-base64-32-byte-random-key
SESSION_TTL_SECONDS=28800
PORTFOLIO_API_URL=http://portfolio-api:8000
# Explicit local HTTP exception; omit this and use HTTPS outside local demo.
ALLOW_INSECURE_HTTP=true

# Optional local traces; authentication requests and framework automatic spans are excluded.
OTEL_TRACES_ENABLED=false
OTEL_SERVICE_NAME=web-bff
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://jaeger:4318/v1/traces
TRACE_VIEWER_URL=http://localhost:16686
