  "components": {
    "schemas": {
      "Claim": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,79}$",
            "title": "Id"
          },
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 10,
            "title": "Text"
          },
          "source_title": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Source Title"
          },
          "source_url": {
            "type": "string",
            "maxLength": 2048,
            "title": "Source Url"
          },
          "locator": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Locator"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "text",
          "source_title",
          "source_url",
          "locator"
        ],
        "title": "Claim"
      },
      "DocumentInput": {
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
            "title": "Key"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "title": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Title"
          },
          "language": {
            "type": "string",
            "title": "Language",
            "default": "vi"
          },
          "visibility": {
            "type": "string",
            "title": "Visibility"
          },
          "markdown": {
            "type": "string",
            "maxLength": 65536,
            "title": "Markdown"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Content Hash"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "available_at": {
            "type": "string",
            "format": "date-time",
            "title": "Available At"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "type": "array",
            "maxItems": 1000,
            "minItems": 1,
            "title": "Claims"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "version",
          "title",
          "visibility",
          "markdown",
          "content_hash",
          "available_at",
          "claims"
        ],
        "title": "DocumentInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LifecycleRequest": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 300,
            "minLength": 3,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "LifecycleRequest"
      },
      "Manifest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "parser_version": {
            "type": "string",
            "title": "Parser Version"
          },
          "chunker_version": {
            "type": "string",
            "title": "Chunker Version"
          },
          "review": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 10,
            "title": "Review"
          },
          "documents": {
            "items": {
              "$ref": "#/components/schemas/DocumentInput"
            },
            "type": "array",
            "maxItems": 1000,
            "minItems": 1,
            "title": "Documents"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "parser_version",
          "chunker_version",
          "review",
          "documents"
        ],
        "title": "Manifest"
      },
      "Query": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Query"
          },
          "corpus_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9-]{36}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Corpus Id"
          },
          "as_of": {
            "type": "string",
            "format": "date-time",
            "title": "As Of"
          },
          "embedding": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array",
                "maxItems": 1536,
                "minItems": 1536
              },
              {
                "type": "null"
              }
            ],
            "title": "Embedding"
          },
          "embedding_model": {
            "anyOf": [
              {
                "type": "string",
                "const": "text-embedding-3-small"
              },
              {
                "type": "null"
              }
            ],
            "title": "Embedding Model"
          },
          "index_version": {
            "type": "string",
            "const": "openai-small-1536-v1",
            "title": "Index Version",
            "default": "openai-small-1536-v1"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query",
          "as_of"
        ],
        "title": "Query"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
