              }
            }
          }
        }
      }
    },
    "/internal/v1/inputs/universes": {
      "get": {
        "summary": "Universes",
        "operationId": "universes_internal_v1_inputs_universes_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/internal/v1/inputs/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_internal_v1_inputs_ready_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "universe_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Universe Id"
            }
          },
          {
            "name": "strategy",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "EW",
                "MVO",
                "BL_ML"
              ],
              "type": "string",
              "title": "Strategy"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/inputs/readiness": {
      "get": {
        "summary": "Readiness",
        "operationId": "readiness_internal_v1_inputs_readiness_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "universe_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Z0-9_-]{1,64}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Universe Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PublicationRequest": {
        "properties": {
          "snapshot_id": {
            "type": "string",
            "format": "uuid",
            "title": "Snapshot Id"
          },
          "snapshot_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Snapshot Hash"
          },
          "universe_id": {
            "type": "string",
            "pattern": "^[A-Z0-9_-]{1,64}$",
            "title": "Universe Id"
          },
          "max_age_days": {
            "type": "integer",
            "maximum": 30.0,
            "minimum": 1.0,
            "title": "Max Age Days",
            "description": "Maximum snapshot age in calendar days (1–30).",
            "default": 7
          },
          "lookback": {
            "type": "integer",
            "maximum": 5000.0,
            "minimum": 2.0,
            "title": "Lookback",
            "default": 252
          },
          "min_returns": {
            "type": "integer",
            "maximum": 5000.0,
            "minimum": 2.0,
            "title": "Min Returns",
            "default": 60
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "snapshot_id",
          "snapshot_hash",
          "universe_id"
        ],
        "title": "PublicationRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
